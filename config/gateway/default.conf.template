resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

log_format json_combined escape=json
  '{"time":"$time_iso8601","request_id":"$request_id","remote_addr":"$remote_addr",'
  '"method":"$request_method","uri":"$request_uri","status":$status,'
  '"bytes_sent":$body_bytes_sent,"request_time":$request_time,'
  '"upstream_addr":"$upstream_addr","upstream_time":"$upstream_response_time",'
  '"user_agent":"$http_user_agent"}';

limit_req_zone $binary_remote_addr zone=api_limit:10m rate=50r/s;
limit_req_zone $binary_remote_addr zone=checkout_limit:10m rate=100r/s;
limit_conn_zone $server_name zone=export_conn:1m;
limit_req_status 429;
limit_conn_status 429;

upstream contratos {
    zone contratos 64k;
    server ${CONTRATOS_HOST}:3000 resolve;
    keepalive 32;
}

upstream flash_sales {
    zone flash_sales 64k;
    server ${FLASH_SALES_HOST}:3000 resolve;
    keepalive 32;
}

upstream flash_sales_export {
    zone flash_sales_export 64k;
    server ${FLASH_SALES_EXPORT_HOST}:3000 resolve;
    keepalive 8;
}

server {
    listen 8080;
    server_name _;
    server_tokens off;
    client_max_body_size 64k;
    access_log /dev/stdout json_combined;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Request-ID $request_id;
    proxy_connect_timeout 2s;
    proxy_read_timeout 15s;
    proxy_next_upstream error timeout http_502 http_503;
    proxy_next_upstream_tries 2;

    add_header X-Request-ID $request_id always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location ~ ^/[^/]+/metrics$ {
        default_type application/json;
        return 404 '{"error":"Not found"}';
    }

    location /contratos/ {
        limit_req zone=api_limit burst=100 nodelay;
        proxy_pass http://contratos/;
    }

    location = /flash-sales/checkout {
        limit_req zone=checkout_limit burst=200 nodelay;
        proxy_pass http://flash_sales/checkout;
    }

    location = /flash-sales/tickets/export {
        limit_conn export_conn 4;
        proxy_read_timeout 120s;
        proxy_pass http://flash_sales_export/tickets/export;
    }

    location /flash-sales/ {
        limit_req zone=api_limit burst=100 nodelay;
        proxy_pass http://flash_sales/;
    }

    location / {
        default_type application/json;
        return 404 '{"error":"Not found"}';
    }
}
